# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Google Places API (New): necesaria para la búsqueda automática de empresas
GOOGLE_PLACES_API_KEY=

# Anthropic (Claude): opcional. Sin clave se usan reglas y plantillas.
ANTHROPIC_API_KEY=
# Modelo y esfuerzo (low | medium | high). medium equilibra calidad y costo.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Fuerza a activar (1) o desactivar (0) la IA aunque haya clave
# PROSPECTOR_USAR_IA=1

# Rutas (opcionales)
# PROSPECTOR_DB=data/prospectos.db
# PROSPECTOR_OFERTA=config/oferta.yaml

# Investigación web
PROSPECTOR_MAX_PAGINAS_SITIO=4
PROSPECTOR_WEB_TIMEOUT=10
